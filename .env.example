APP_PORT=8080
PGDATABASE=audiovisual
PGUSER=audiovisual
PGPASSWORD=local-development-only

# Cuenta administrativa. El proceso de inicialización la crea con el rol ADMIN
# y guarda solo el hash Argon2id de la contraseña. Define el valor real en tu
# archivo .env local, que .gitignore mantiene fuera del repositorio.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=define-tu-contrasena-en-el-env-local

# Activa Secure en la cookie de sesión. Solo con HTTPS; en local déjala en false.
SESSION_COOKIE_SECURE=false
